/-
#reduce (mixS,simpSet)
#reduce (poseidon,simpSet)
#reduce (keyless,simpSet)
#compile keyless

-- order irrelevant?
let toBeReduced := [(mixS, simp1), (poseidon, 1, simp2), (keyless, simp3, simp3b)]

-- how to identify functions? name and arguments?
let (fn,args) := e.getAppfnargs -- do we get the implicits?

cache := (poseidon 2, poseidon 4, mixS 2, mixS 4)


app (app f a) b

Meta.tranform (post:= fun e ↦
  let (fn,args) := e.getAppfnargs
  if toBeReduced.contains fn then
    let reduced :=
      if cache.contains e then
        cache.get e
      else
        let e := expandVectors e
        let e := simp e simp
        -- if we have a second simpset then we simp again
        cache.add e
        return e
    .done reduced
)
-/

