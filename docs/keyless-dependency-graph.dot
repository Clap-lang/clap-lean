  legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3"><B>Legend</B></TD></TR><TR><TD BGCOLOR="#a8dba8" WIDTH="24"> </TD><TD ALIGN="LEFT">proven (convertsM, no sorry)</TD><TD ALIGN="RIGHT">86</TD></TR><TR><TD BGCOLOR="#ffb870" WIDTH="24"> </TD><TD ALIGN="LEFT">ported, spec has sorry</TD><TD ALIGN="RIGHT">2</TD></TR><TR><TD BGCOLOR="#fff1a0" WIDTH="24"> </TD><TD ALIGN="LEFT">ported, no spec</TD><TD ALIGN="RIGHT">1</TD></TR><TR><TD BGCOLOR="#f4a6a6" WIDTH="24"> </TD><TD ALIGN="LEFT">not ported (old model only)</TD><TD ALIGN="RIGHT">33</TD></TR><TR><TD BGCOLOR="#b4d4f0" WIDTH="24"> </TD><TD ALIGN="LEFT">CLAP gate (eDSL primitive)</TD><TD ALIGN="RIGHT">5</TD></TR><TR><TD></TD><TD ALIGN="LEFT"><B>total</B></TD><TD ALIGN="RIGHT"><B>127</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9">new: file under Clap/Lang/ · old: definition under old/Clap/, (c) = commented out</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9">Aptos: the Circom template it corresponds to, for reference only</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9">edges into gates are faded</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9">omitted: mkF/mkAdd/mkSub/mkMul, iteration combinators, test helpers;</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9">internal steps (e.g. isSubstring.check) are folded into their gadget</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9">sorryAx from bn254/goldilocks primality is ignored</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9">Aptos reference: keyless-zk-proofs @ dc10a06</FONT></TD></TR></TABLE>>];
